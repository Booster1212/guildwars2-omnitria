{
  "name": "omnitria",
  "version": "0.1.7",
  "description": "Omnitria - Guild Wars 2 In-Game Overlay (Events, WvW Tactics, Crafting, Legendary Armory & Achievements)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "overlay": "concurrently -k -s first \"vite\" \"wait-on tcp:5188 && electron electron/main.cjs\"",
    "electron": "electron electron/main.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "sync-data": "node scripts/sync-community-data.mjs",
    "package:win": "node scripts/package-windows.mjs"
  },
  "keywords": [
    "guild-wars-2",
    "gw2",
    "overlay",
    "world-bosses",
    "meta-events"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.5.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
